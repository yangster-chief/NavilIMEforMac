/* 지역화된 InfoPlist.strings 가 존재하면 macOS 는 앱 이름도 여기서 찾는다.
   CFBundleName 을 빠뜨리면 트레이 메뉴 머리글에 "CFBundleName" 이라는
   키 이름이 그대로 노출된다. */
"CFBundleName" = "나빌입력기";
"CFBundleDisplayName" = "나빌입력기";

/* 입력 소스 목록(시스템 설정 > 키보드 > 입력 소스)에 표시되는 이름.
   키는 Info.plist의 ComponentInputModeDict에 선언한 입력 모드 ID와 정확히 같아야 한다.
   이 항목이 없으면 목록에 모드 ID 문자열이 그대로 노출된다. */
"com.navilera.inputmethod.NavilIME.Hangul" = "나빌입력기";
"com.navilera.inputmethod.NavilIME.Roman" = "나빌입력기 (영문)";
